# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=4000

# --- PostgreSQL connection ---
# If using a local Postgres install:
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/abbas_shop

# If using a hosted DB like Supabase/Neon/Render, paste their connection string instead, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Auth ---
# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# --- CORS ---
# The origin your frontend is served from (Live Server default shown below)
FRONTEND_ORIGIN=http://127.0.0.1:5500

# ── Order emails ──
# Admin gets an email for every new order; customers get an email when their order status changes.
# Choose ONE provider: smtp | brevo | resend
EMAIL_PROVIDER=smtp
# SMTP (e.g. Gmail: host smtp.gmail.com, port 465, user = your Gmail, pass = a Google App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=                 # true for port 465; leave empty to auto-detect from the port
SMTP_USER=
SMTP_PASS=
# BREVO_API_KEY=             # if EMAIL_PROVIDER=brevo
# RESEND_API_KEY=            # if EMAIL_PROVIDER=resend (requires a verified domain)
EMAIL_FROM=                  # sender address (for SMTP usually the same as SMTP_USER)
EMAIL_FROM_NAME=Abs Fragrances
# Where new-order alerts go (takes priority). If empty, the email set in Admin → Social & Contact is used.
ADMIN_NOTIFY_EMAIL=
