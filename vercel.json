{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "abs-fragrances.vercel.app" }],
      "destination": "https://www.abs-fragrances.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
